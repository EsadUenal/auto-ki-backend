# ──────────────────────────────────────────────────────────────────────────────
# Auto-KI Backend — Umgebungsvariablen
#
# 1. Diese Datei kopieren: copy .env.example .env
# 2. In .env die echten Werte eintragen (niemals .env committen!)
# 3. .env steht bereits in .gitignore
# ──────────────────────────────────────────────────────────────────────────────

# ── Stripe ────────────────────────────────────────────────────────────────────
# Testmodus-Keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_DEIN_SECRET_KEY_HIER

# Webhook-Secret — ändert sich bei jedem "stripe listen"-Start.
# Ausgabe nach dem Starten: "Ready! Your webhook signing secret is whsec_..."
# Tipp: stripe listen gibt das Secret direkt in der Konsole aus.
STRIPE_WEBHOOK_SECRET=whsec_DEIN_WEBHOOK_SECRET_HIER

# Stripe Price-IDs — unter https://dashboard.stripe.com/test/products
# Je Produkt auf "Preise" klicken, die price_xxx-ID kopieren.
# LIGHT/PRO/MAX/EINZELKAUF werden NICHT mehr verkauft — keine Price-IDs dafuer
# setzen. /payments/checkout-session lehnt diese Produkte ab; laufende
# Bestandsabos werden weiter ueber den Webhook verarbeitet.
# Consumer Pricing V1 — getrennte Einmalprodukte je Check-Art.
# Ohne diese IDs liefert /payments/checkout-session fuer den jeweiligen Check
# bewusst 500 (Konfigurationsfehler) statt auf ein falsches Produkt auszuweichen.
STRIPE_PRICE_KAUFCHECK=price_KAUFCHECK_ID_HIER
STRIPE_PRICE_VERKAUFSCHECK=price_VERKAUFSCHECK_ID_HIER
# VIRA Plus — einziges neu angebotenes Abo (recurring, monatlich).
STRIPE_PRICE_PLUS=price_PLUS_ID_HIER

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL des Frontends für Stripe Redirect-URLs (success/cancel)
FRONTEND_URL=http://localhost:3000

# ── KI / Suche ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=DEIN_GEMINI_API_KEY_HIER
TAVILY_API_KEY=tvly-DEIN_TAVILY_KEY_HIER

# ── Umgebung ──────────────────────────────────────────────────────────────────
# development (lokal, Default) | production (Dockerfile setzt es fest).
# In production verweigert die App den Start bei fehlenden/Default-Secrets
# (JWT, API-Key, STRIPE_WEBHOOK_SECRET) und setzt das Auth-Cookie auf Secure.
# Jeder andere Wert als "development" gilt als production.
AUTO_KI_ENV=development

# ── Auth ──────────────────────────────────────────────────────────────────────
# Langen Zufalls-String verwenden: openssl rand -hex 32
AUTO_KI_JWT_SECRET=BITTE_DURCH_LANGEN_ZUFALLS_STRING_ERSETZEN
# Consumer-API-Key — langer Zufalls-String, anderer Wert als das JWT-Secret.
# Steht als VITE_API_KEY im oeffentlichen Frontend-Bundle und oeffnet NUR die
# Consumer-Routen (Checks, Chat, AutoFinder, /fahrzeug) — kein Admin-Zugang.
# Ohne Setzen: oeffentlich bekannter Dev-Default (in production: Start verweigert).
AUTO_KI_API_KEY=BITTE_DURCH_LANGEN_ZUFALLS_STRING_ERSETZEN
# Admin-Key: nur fuer /api/v1/admin/* — eigener Zufalls-String (>= 32 Zeichen),
# NIE im Frontend, NIE als VITE_-Variable. Leer = Admin-Endpunkte geschlossen.
AUTO_KI_ADMIN_API_KEY=

# ── Produktion / Betrieb ──────────────────────────────────────────────────────
# CORS: exakte Frontend-Origin(s), komma-getrennt. Muss die echte Domain sein,
# unter der das Frontend läuft (Cookies funktionieren nur mit konkreten Origins).
AUTO_KI_CORS_ORIGINS=https://deine-domain.de

# Datenpfade — in Prod auf ein PERSISTENTES Volume zeigen lassen.
# Im mitgelieferten Dockerfile bereits auf /data/... vorbelegt; nur überschreiben,
# wenn der Volume-Mount woanders liegt.
AUTO_KI_DB_PATH=/data/auto_ki.db
AUTO_KI_CHROMA_PATH=/data/chroma
AUTO_KI_DB_BACKUP_DIR=/data/backups

# Rate-Limit (global) und Log-Level. Defaults: 20/minute bzw. INFO.
AUTO_KI_RATE_LIMIT=20/minute
# Monatskontingente (UTC-Kalendermonat, 0 = kein Limit).
# Ergaenzen AUTO_KI_RATE_LIMIT (pro Minute) um einen Monatsdeckel.
AUTO_KI_CHAT_FREE_LIMIT_MONATLICH=20
AUTO_KI_CHAT_PLUS_LIMIT_MONATLICH=100
AUTO_KI_AUTOFINDER_FREE_LIMIT_MONATLICH=5
AUTO_KI_AUTOFINDER_PLUS_LIMIT_MONATLICH=50
# In VIRA Plus enthaltene Checks je bezahltem Abrechnungszeitraum.
AUTO_KI_PLUS_KAUFCHECKS=5
AUTO_KI_PLUS_VERKAUFSCHECKS=1
AUTO_KI_LOG_LEVEL=INFO

# Periodisches Vollbackup der SQLite-DB (Sekunden). Deckt auch Nutzerdaten ab,
# die sonst nur bei Fahrzeug-Admin-Schreibvorgängen gesichert würden.
# Default: 21600 (6 Stunden). 0 oder negativ deaktiviert den Timer.
AUTO_KI_DB_BACKUP_INTERVAL_SECONDS=21600
