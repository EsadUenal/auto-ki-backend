# ── Secrets — NIEMALS ins Image ────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Lokale Daten (gehören ins persistente Volume, nicht ins Image) ──────────
# Nur die tatsaechlichen Datenbank-DATEIEN ausschliessen, NICHT das ganze db/.
# Bis zum Bootstrap-Umbau stand hier "db/" — damit fehlten dem Image
# db/schema.sql und der kanonische Fahrzeug-Seed, und ein frisch deployter
# Container hatte weder Fahrzeugtabellen noch Fahrzeugdaten.
*.db
*.db-wal
*.db-shm
db/backups
db/chroma

# ── Git / IDE ──────────────────────────────────────────────────────────────
.git/
.gitignore
.vscode/
.idea/

# ── Python-Artefakte ───────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# ── Entwicklungs-/Diagnose-Skripte & Tests (nicht im Prod-Image nötig) ──────
# HINWEIS: migrate_db.py und rebuild_chroma.py bleiben BEWUSST im Image —
# sie werden zum einmaligen Seeden des Prod-Volumes gebraucht
# (z.B. `railway run python rebuild_chroma.py`).
diag_*.py
test_*.py
tests/

# ── Doku ───────────────────────────────────────────────────────────────────
*.md
